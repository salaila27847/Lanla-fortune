# จาก Google AI Studio (aistudio.google.com) -> Get API key — ฟรี ไม่ต้องผูกบัตรเครดิต
GEMINI_API_KEY=your_key_here
DATABASE_URL=sqlite:///./dev.db
SYNTHESIS_MODEL=gemini-3.1-flash-lite
FRONTEND_ORIGIN=http://localhost:3000

# ต้องตรงกับ INTERNAL_API_SECRET ฝั่ง frontend/.env.local เป๊ะๆ (สร้างด้วย: openssl rand -hex 32)
INTERNAL_API_SECRET=your_shared_secret_here
