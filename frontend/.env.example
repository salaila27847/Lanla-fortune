# สร้างด้วยคำสั่ง: npx auth secret
AUTH_SECRET=your_random_secret_here

# ได้จาก Google Cloud Console -> APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID (Web application)
# Authorized redirect URI (dev): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Backend URL — server-only (never sent to the browser). The frontend server
# proxies /reading and /history through this after verifying the login itself.
BACKEND_INTERNAL_URL=http://localhost:8000

# ต้องตรงกับ INTERNAL_API_SECRET ฝั่ง backend/.env เป๊ะๆ (สร้างด้วย: openssl rand -hex 32)
INTERNAL_API_SECRET=your_shared_secret_here
